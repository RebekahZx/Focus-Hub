# Copy to .env.local for local development, or add these in Vercel → Settings → Environment Variables.
MONGODB_URI=mongodb://127.0.0.1:27017/focus-hub

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=        # any long random string, e.g. output of: openssl rand -base64 32

# Sign-in. Configure at least one provider; missing ones are hidden on the sign-in page.
# OAuth callback URLs: <site>/api/auth/callback/google and <site>/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Optional: your own Jitsi server or a JaaS domain for the video room (default: meet.jit.si)
NEXT_PUBLIC_JITSI_DOMAIN=
