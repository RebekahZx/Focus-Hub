# Copy to .env.local and fill in.
MONGODB_URI=mongodb://127.0.0.1:27017/focus-hub

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=        # e.g. output of: openssl rand -base64 32

# OAuth apps. Callback URLs:
#   http://localhost:3000/api/auth/callback/github
#   http://localhost:3000/api/auth/callback/google
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: your own Jitsi server or JaaS domain (default: meet.jit.si)
NEXT_PUBLIC_JITSI_DOMAIN=
